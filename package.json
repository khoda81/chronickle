{
  "name": "chronickle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Correlate market volatility with real-world events on a scrubbable timeline.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,css,html}'",
    "format:check": "prettier --check 'src/**/*.{ts,css,html}'"
  },
  "devDependencies": {
    "@types/d3-time": "^3.0.4",
    "prettier": "^3.8.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "d3-time": "^3.1.0"
  }
}
