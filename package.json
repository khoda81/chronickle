{
  "name": "chronickle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Correlate market volatility with real-world events on a scrubbable timeline.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "bun run test/run.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,html}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,html}'"
  },
  "devDependencies": {
    "@types/d3-time": "^3.0.4",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.12"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.12",
    "@solid-primitives/storage": "^4.4.0",
    "d3-time": "^3.1.0",
    "lucide-solid": "^1.24.0",
    "solid-js": "^1.9.14"
  }
}
